		{
			"id": "archive.rar.remove",
			"label": "Remove from archive",
			"when": {
				"in": [
					"archive.rar"
				]
			},
			"ways": [
				{
					"programs": [
						"rar"
					],
					"run": [
						"sh",
						"-c",
						"for e; do case \"$e\" in *[*?]*) echo \"rar cannot be told to take “$e” as a name and not a pattern, so it is not removed: nothing was.\" >&2; exit 2;; esac; set -- \"$@\" \"${e%/}\"; shift; done; rar d -idq \"$archive\" \"$@\"",
						"sh",
						"{entries}"
					]
				}
			],
			"how": {
				"watched": true,
				"confirm": "What is removed from the archive cannot be put back."
			},
			"then": {
				"reread": true
			},
			"key": "Delete"
		},
