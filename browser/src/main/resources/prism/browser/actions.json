{
	"places": [
		{
			"id": "archive.tar",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"sidebar": false,
			"ways": [
				{
					"programs": [
						"bsdtar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(LC_ALL=C bsdtar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'",
						"sh"
					]
				},
				{
					"programs": [
						"tar"
					],
					"list": [
						"sh",
						"-c",
						"if tar --version 2>/dev/null | grep -q \"GNU tar\"; then out=$(tar --quoting-style=literal -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk '{ size = $3; time = $4 \" \" $5; name = $0; for (i = 0; i < 5; i++) sub(/^[^ ]+ +/, \"\", name); if (substr($1, 1, 1) == \"l\") sub(/ -> .*$/, \"\", name); if (substr($1, 1, 1) == \"h\") sub(/ link to .*$/, \"\", name); if (name != \"\") printf \"%s\\tsize=%s\\ttime=%s\\n\", name, size, time }'; else out=$(LC_ALL=C tar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'; fi",
						"sh"
					]
				}
			],
			"read": "names",
			"out": "archive.tar.extract",
			"in": "archive.tar.add"
		},
		{
			"id": "archive.zip",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"sidebar": false,
			"ways": [
				{
					"programs": [
						"zipinfo"
					],
					"list": [
						"sh",
						"-c",
						"out=$(zipinfo -T \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk '/^[-dl?]/ && NF >= 8 { size = $4; time = $7; name = $0; for (i = 0; i < 7; i++) sub(/^[^ ]+ +/, \"\", name); printf \"%s\\tsize=%s\\ttime=%s\\n\", name, size, time }'",
						"sh"
					]
				},
				{
					"programs": [
						"7zz|7z|7za|7zr"
					],
					"list": [
						"sh",
						"-c",
						"out=$(\"$1\" l -slt -ba -- \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk 'function out() { if (p != \"\") printf \"%s%s\\tsize=%s\\ttime=%s\\n\", p, (d ? \"/\" : \"\"), s, m; p = \"\"; d = 0; s = \"\"; m = \"\" } /^Path = / { out(); p = substr($0, 8); next } /^Folder = \\+/ { d = 1 } /^Attributes = D/ { d = 1 } /^Size = / { s = substr($0, 8) } /^Modified = / { m = substr($0, 12, 19) } END { out() }'",
						"sh",
						"{which:7zz|7z|7za|7zr}"
					]
				},
				{
					"programs": [
						"bsdtar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(LC_ALL=C bsdtar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'",
						"sh"
					]
				}
			],
			"read": "names",
			"out": "archive.zip.extract",
			"in": "archive.zip.add"
		},
		{
			"id": "archive.7z",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"sidebar": false,
			"ways": [
				{
					"programs": [
						"7zz|7z|7za|7zr"
					],
					"list": [
						"sh",
						"-c",
						"out=$(\"$1\" l -slt -ba -- \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk 'function out() { if (p != \"\") printf \"%s%s\\tsize=%s\\ttime=%s\\n\", p, (d ? \"/\" : \"\"), s, m; p = \"\"; d = 0; s = \"\"; m = \"\" } /^Path = / { out(); p = substr($0, 8); next } /^Folder = \\+/ { d = 1 } /^Attributes = D/ { d = 1 } /^Size = / { s = substr($0, 8) } /^Modified = / { m = substr($0, 12, 19) } END { out() }'",
						"sh",
						"{which:7zz|7z|7za|7zr}"
					]
				},
				{
					"programs": [
						"bsdtar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(LC_ALL=C bsdtar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'",
						"sh"
					]
				}
			],
			"read": "names",
			"out": "archive.7z.extract",
			"in": "archive.7z.add"
		},
		{
			"id": "archive.rar",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"sidebar": false,
			"ways": [
				{
					"programs": [
						"unrar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(unrar lt -cfg- -- \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk 'function out() { if (p != \"\") printf \"%s%s\\tsize=%s\\ttime=%s\\n\", p, (d ? \"/\" : \"\"), s, m; p = \"\"; d = 0; s = \"\"; m = \"\" } /^ *Name: / { out(); sub(/^ *Name: /, \"\"); p = $0; next } /^ *Type: Directory/ { d = 1 } /^ *Size: / { s = $2 } /^ *mtime: / { m = $2 \" \" substr($3, 1, 8) } END { out() }'",
						"sh"
					]
				},
				{
					"programs": [
						"7zz|7z|7za|7zr"
					],
					"list": [
						"sh",
						"-c",
						"out=$(\"$1\" l -slt -ba -- \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk 'function out() { if (p != \"\") printf \"%s%s\\tsize=%s\\ttime=%s\\n\", p, (d ? \"/\" : \"\"), s, m; p = \"\"; d = 0; s = \"\"; m = \"\" } /^Path = / { out(); p = substr($0, 8); next } /^Folder = \\+/ { d = 1 } /^Attributes = D/ { d = 1 } /^Size = / { s = substr($0, 8) } /^Modified = / { m = substr($0, 12, 19) } END { out() }'",
						"sh",
						"{which:7zz|7z|7za|7zr}"
					]
				},
				{
					"programs": [
						"bsdtar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(LC_ALL=C bsdtar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'",
						"sh"
					]
				}
			],
			"read": "names",
			"out": "archive.rar.extract",
			"in": "archive.rar.add"
		},
		{
			"id": "archive.disk",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"sidebar": false,
			"ways": [
				{
					"programs": [
						"7zz|7z|7za|7zr"
					],
					"list": [
						"sh",
						"-c",
						"out=$(\"$1\" l -slt -ba -- \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk 'function out() { if (p != \"\") printf \"%s%s\\tsize=%s\\ttime=%s\\n\", p, (d ? \"/\" : \"\"), s, m; p = \"\"; d = 0; s = \"\"; m = \"\" } /^Path = / { out(); p = substr($0, 8); next } /^Folder = \\+/ { d = 1 } /^Attributes = D/ { d = 1 } /^Size = / { s = substr($0, 8) } /^Modified = / { m = substr($0, 12, 19) } END { out() }'",
						"sh",
						"{which:7zz|7z|7za|7zr}"
					]
				},
				{
					"programs": [
						"bsdtar"
					],
					"list": [
						"sh",
						"-c",
						"out=$(LC_ALL=C bsdtar -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk -v now=\"$(date +%Y%m)\" 'BEGIN { split(\"Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec\", names, \" \"); for (i = 1; i <= 12; i++) month[names[i]] = i } { name = $0; for (i = 0; i < 8; i++) sub(/^ *[^ ]+ +/, \"\", name); t = substr($1, 1, 1); if (t == \"l\") sub(/ -> .*$/, \"\", name); if (t == \"h\") sub(/ link to .*$/, \"\", name); sub(/\\/$/, \"\", name); mo = month[$6]; if ($8 ~ /:/) { y = substr(now, 1, 4) + 0; if (mo > substr(now, 5, 2) + 0) y--; clock = $8 } else { y = $8; clock = \"00:00\" } if (name != \"\" && name != \".\") printf \"%s%s\\tsize=%s\\ttime=%04d-%02d-%02d %s\\n\", name, (t == \"d\" ? \"/\" : \"\"), $5, y, mo, $7, clock }'",
						"sh"
					]
				}
			],
			"read": "names",
			"out": "archive.disk.extract"
		},
		{
			"id": "git.changes",
			"title": "Changes in {repo.name}",
			"takes": [
				"repo"
			],
			"opens": "here",
			"list": [
				"git",
				"diff",
				"--name-only",
				"--relative",
				"-z",
				"HEAD"
			],
			"folder": "{repo}",
			"read": "paths",
			"tree": true,
			"nul": true
		}
	],
	"actions": [
		{
			"id": "containing-folder",
			"label": "Open containing folder",
			"when": {
				"count": "one",
				"elsewhere": true
			},
			"show": {
				"folder": "{parent}",
				"choose": "{name}"
			}
		},
		{
			"id": "containing-folder-window",
			"label": "Open containing folder in new window",
			"when": {
				"count": "one",
				"elsewhere": true
			},
			"show": {
				"folder": "{parent}",
				"in": "window"
			}
		},
		{
			"id": "archive.tar.open",
			"label": "Open",
			"default": true,
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"taz",
					"tar.bz2",
					"tbz2",
					"tbz",
					"tb2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tar.zstd",
					"tzst",
					"tar.lz",
					"tlz",
					"tar.lzma",
					"tar.lz4",
					"tar.lzo",
					"tzo",
					"tar.Z"
				],
				"kind": "file",
				"count": "one"
			},
			"show": {
				"place": "archive.tar",
				"with": {
					"archive": "{path}"
				}
			}
		},
		{
			"id": "archive.tar.unpack",
			"label": "Extract to…",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"taz",
					"tar.bz2",
					"tbz2",
					"tbz",
					"tb2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tar.zstd",
					"tzst",
					"tar.lz",
					"tlz",
					"tar.lzma",
					"tar.lz4",
					"tar.lzo",
					"tzo",
					"tar.Z"
				],
				"kind": "file"
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{folder}"
				}
			},
			"ways": [
				{
					"programs": [
						"bsdtar"
					],
					"run": [
						"sh",
						"-c",
						"mkdir -p -- \"$dest\" && bsdtar -xkf \"$1\" -C \"$dest\"",
						"sh",
						"{path}"
					]
				},
				{
					"programs": [
						"tar"
					],
					"run": [
						"sh",
						"-c",
						"mkdir -p -- \"$dest\" && if tar --version 2>/dev/null | grep -q \"GNU tar\"; then tar --skip-old-files -xf \"$1\" -C \"$dest\"; else tar -xkf \"$1\" -C \"$dest\"; fi",
						"sh",
						"{path}"
					]
				}
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.tar.unpack-here",
			"label": "Extract here",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"taz",
					"tar.bz2",
					"tbz2",
					"tbz",
					"tb2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tar.zstd",
					"tzst",
					"tar.lz",
					"tlz",
					"tar.lzma",
					"tar.lz4",
					"tar.lzo",
					"tzo",
					"tar.Z"
				],
				"kind": "file"
			},
			"like": "archive.tar.unpack",
			"given": {
				"dest": "{folder}"
			}
		},
		{
			"id": "archive.tar.unpack-folder",
			"label": "Extract into a folder",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"taz",
					"tar.bz2",
					"tbz2",
					"tbz",
					"tb2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tar.zstd",
					"tzst",
					"tar.lz",
					"tlz",
					"tar.lzma",
					"tar.lz4",
					"tar.lzo",
					"tzo",
					"tar.Z"
				],
				"kind": "file",
				"count": "one"
			},
			"like": "archive.tar.unpack",
			"given": {
				"dest": "{folder}/{stem}"
			},
			"then": {
				"choose": "{stem}"
			}
		},
		{
			"id": "archive.tar.extract",
			"label": "Extract to…",
			"when": {
				"in": [
					"archive.tar"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"ways": [
				{
					"programs": [
						"bsdtar"
					],
					"run": [
						"sh",
						"-c",
						"t=$1; shift; esc() { printf '%s' \"$1\" | sed 's/[][*?\\\\]/\\\\&/g'; }; for e; do set -- \"$@\" \"$(esc \"${e%/}\")\"; shift; done; bsdtar -xf \"$archive\" -C \"$t\" -- \"$@\"",
						"sh",
						"{temp}",
						"{entries}"
					]
				},
				{
					"programs": [
						"tar"
					],
					"run": [
						"sh",
						"-c",
						"t=$1; shift; for e; do set -- \"$@\" \"${e%/}\"; shift; done; tar --no-wildcards -xf \"$archive\" -C \"$t\" -- \"$@\"",
						"sh",
						"{temp}",
						"{entries}"
					]
				}
			],
			"how": {
				"watched": true
			},
			"then": {
				"bring": {
					"from": "{temp}",
					"to": "{dest}"
				},
				"reread": true
			}
		},
		{
			"id": "archive.tar.extract-beside",
			"label": "Extract beside the archive",
			"when": {
				"in": [
					"archive.tar"
				]
			},
			"like": "archive.tar.extract",
			"given": {
				"dest": "{archive.parent}"
			}
		},
		{
			"id": "archive.tar.extract-all",
			"label": "Extract all to…",
			"when": {
				"target": "folder",
				"in": [
					"archive.tar"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"ways": [
				{
					"programs": [
						"bsdtar"
					],
					"run": [
						"sh",
						"-c",
						"mkdir -p -- \"$dest\" && bsdtar -xkf \"$1\" -C \"$dest\"",
						"sh",
						"{archive}"
					]
				},
				{
					"programs": [
						"tar"
					],
					"run": [
						"sh",
						"-c",
						"mkdir -p -- \"$dest\" && if tar --version 2>/dev/null | grep -q \"GNU tar\"; then tar --skip-old-files -xf \"$1\" -C \"$dest\"; else tar -xkf \"$1\" -C \"$dest\"; fi",
						"sh",
						"{archive}"
					]
				}
			],
			"how": {
				"watched": true
			}
		},
		{
			"id": "archive.tar.remove",
			"label": "Remove from archive",
			"when": {
				"in": [
					"archive.tar"
				],
				"with": {
					"archive": [
						"*.tar"
					]
				}
			},
			"ways": [
				{
					"programs": [
						"tar"
					],
					"run": [
						"sh",
						"-c",
						"for e; do set -- \"$@\" \"${e%/}\"; shift; done; tar --no-wildcards --delete -f \"$archive\" -- \"$@\"",
						"sh",
						"{entries}"
					]
				}
			],
			"how": {
				"watched": true,
				"confirm": "What is removed from the archive cannot be put back."
			},
			"then": {
				"reread": true
			},
			"key": "Delete"
		},
		{
			"id": "archive.tar.add",
			"label": "Add to archive",
			"when": {
				"in": [
					"archive.tar"
				],
				"real": true,
				"with": {
					"archive": [
						"*.tar"
					]
				}
			},
			"ways": [
				{
					"programs": [
						"bsdtar"
					],
					"run": [
						"bsdtar",
						"-rf",
						"{archive}",
						"--",
						"{names}"
					]
				},
				{
					"programs": [
