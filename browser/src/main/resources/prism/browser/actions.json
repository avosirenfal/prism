						"x",
						"-y",
						"-spd",
						"-bso0",
						"-bsp0",
						"-o{temp}",
						"{archive}",
						"--",
						"{entries}"
					]
				},
				{
					"programs": [
						"bsdtar"
					],
					"run": [
						"sh",
						"-c",
						"t=$1; shift; esc() { printf '%s' \"$1\" | sed 's/[][*?\\\\]/\\\\&/g'; }; for e; do set -- \"$@\" \"$(esc \"${e%/}\")\"; shift; done; bsdtar -xf \"$archive\" -C \"$t\" -- \"$@\"",
