{
	"places": [
		{
			"id": "archive.tar",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"list": [
				"sh",
				"-c",
				"out=$(tar --quoting-style=literal -tvf \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk '{ size = $3; time = $4 \" \" $5; name = $0; for (i = 0; i < 5; i++) sub(/^[^ ]+ +/, \"\", name); if (substr($1, 1, 1) == \"l\") sub(/ -> .*$/, \"\", name); if (substr($1, 1, 1) == \"h\") sub(/ link to .*$/, \"\", name); if (name != \"\") printf \"%s\\tsize=%s\\ttime=%s\\n\", name, size, time }'"
			],
			"read": "names",
			"out": "archive.tar.extract",
			"in": "archive.tar.add",
			"sidebar": false
		},
		{
			"id": "archive.zip",
			"title": "{archive.name}",
			"takes": [
				"archive"
			],
			"opens": "window",
			"list": [
				"sh",
				"-c",
				"out=$(zipinfo -T \"$archive\") || exit 1; printf '%s\\n' \"$out\" | awk '/^[-dl?]/ && NF >= 8 { size = $4; time = $7; name = $0; for (i = 0; i < 7; i++) sub(/^[^ ]+ +/, \"\", name); printf \"%s\\tsize=%s\\ttime=%s\\n\", name, size, time }'"
			],
			"read": "names",
			"out": "archive.zip.extract",
			"in": "archive.zip.add",
			"sidebar": false
		},
		{
			"id": "git.changes",
			"title": "Changes in {repo.name}",
			"takes": [
				"repo"
			],
			"opens": "here",
			"list": [
				"git",
				"diff",
				"--name-only",
				"--relative",
				"-z",
				"HEAD"
			],
			"folder": "{repo}",
			"read": "paths",
			"tree": true,
			"nul": true
		}
	],
	"actions": [
		{
			"id": "containing-folder",
			"label": "Open containing folder",
			"when": {
				"count": "one",
				"elsewhere": true
			},
			"show": {
				"folder": "{parent}",
				"choose": "{name}"
			}
		},
		{
			"id": "containing-folder-window",
			"label": "Open containing folder in new window",
			"when": {
				"count": "one",
				"elsewhere": true
			},
			"show": {
				"folder": "{parent}",
				"in": "window"
			}
		},
		{
			"id": "archive.tar.view",
			"label": "View contents",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"tar.bz2",
					"tbz2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tzst"
				],
				"kind": "file",
				"count": "one",
				"programs": [
					"tar"
				]
			},
			"show": {
				"place": "archive.tar",
				"with": {
					"archive": "{path}"
				}
			}
		},
		{
			"id": "archive.zip.view",
			"label": "View contents",
			"when": {
				"ext": [
					"zip",
					"jar",
					"war",
					"apk",
					"cbz",
					"epub",
					"odt",
					"ods",
					"odp",
					"docx",
					"xlsx",
					"pptx"
				],
				"kind": "file",
				"count": "one",
				"programs": [
					"zipinfo",
					"unzip"
				]
			},
			"show": {
				"place": "archive.zip",
				"with": {
					"archive": "{path}"
				}
			}
		},
		{
			"id": "archive.tar.extract-here",
			"label": "Extract here",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"tar.bz2",
					"tbz2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tzst"
				],
				"kind": "file",
				"programs": [
					"tar"
				]
			},
			"run": [
				"tar",
				"--skip-old-files",
				"-xf",
				"{path}",
				"-C",
				"{folder}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.zip.extract-here",
			"label": "Extract here",
			"when": {
				"ext": [
					"zip",
					"jar",
					"war",
					"apk",
					"cbz",
					"epub",
					"odt",
					"ods",
					"odp",
					"docx",
					"xlsx",
					"pptx"
				],
				"kind": "file",
				"programs": [
					"unzip"
				]
			},
			"run": [
				"unzip",
				"-n",
				"-q",
				"{path}",
				"-d",
				"{folder}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.tar.extract-folder",
			"label": "Extract into a folder",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"tar.bz2",
					"tbz2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tzst"
				],
				"kind": "file",
				"programs": [
					"tar"
				]
			},
			"run": [
				"sh",
				"-c",
				"mkdir -p -- \"$1\" && tar --skip-old-files -xf \"$2\" -C \"$1\"",
				"sh",
				"{stem}",
				"{path}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{stem}"
			}
		},
		{
			"id": "archive.zip.extract-folder",
			"label": "Extract into a folder",
			"when": {
				"ext": [
					"zip",
					"jar",
					"war",
					"apk",
					"cbz",
					"epub",
					"odt",
					"ods",
					"odp",
					"docx",
					"xlsx",
					"pptx"
				],
				"kind": "file",
				"programs": [
					"unzip"
				]
			},
			"run": [
				"unzip",
				"-n",
				"-q",
				"{path}",
				"-d",
				"{stem}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{stem}"
			}
		},
		{
			"id": "archive.tar.extract-to",
			"label": "Extract to…",
			"when": {
				"ext": [
					"tar",
					"tar.gz",
					"tgz",
					"tar.bz2",
					"tbz2",
					"tar.xz",
					"txz",
					"tar.zst",
					"tzst"
				],
				"kind": "file",
				"programs": [
					"tar"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{folder}"
				}
			},
			"run": [
				"tar",
				"--skip-old-files",
				"-xf",
				"{path}",
				"-C",
				"{dest}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.zip.extract-to",
			"label": "Extract to…",
			"when": {
				"ext": [
					"zip",
					"jar",
					"war",
					"apk",
					"cbz",
					"epub",
					"odt",
					"ods",
					"odp",
					"docx",
					"xlsx",
					"pptx"
				],
				"kind": "file",
				"programs": [
					"unzip"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{folder}"
				}
			},
			"run": [
				"unzip",
				"-n",
				"-q",
				"{path}",
				"-d",
				"{dest}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "compress.zip",
			"label": "As a .zip…",
			"submenu": "Compress",
			"when": {
				"count": "some",
				"real": true,
				"in": [
					"folder"
				],
				"programs": [
					"zip"
				]
			},
			"ask": {
				"to": {
					"text": "Name of the archive",
					"start": "{stem}"
				}
			},
			"run": [
				"zip",
				"-q",
				"-r",
				"{to}.zip",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{to}.zip"
			}
		},
		{
			"id": "compress.tar-gz",
			"label": "As a .tar.gz…",
			"submenu": "Compress",
			"when": {
				"count": "some",
				"real": true,
				"in": [
					"folder"
				],
				"programs": [
					"tar",
					"gzip"
				]
			},
			"ask": {
				"to": {
					"text": "Name of the archive",
					"start": "{stem}"
				}
			},
			"run": [
				"tar",
				"-czf",
				"{to}.tar.gz",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{to}.tar.gz"
			}
		},
		{
			"id": "compress.tar-xz",
			"label": "As a .tar.xz…",
			"submenu": "Compress",
			"when": {
				"count": "some",
				"real": true,
				"in": [
					"folder"
				],
				"programs": [
					"tar",
					"xz"
				]
			},
			"ask": {
				"to": {
					"text": "Name of the archive",
					"start": "{stem}"
				}
			},
			"run": [
				"tar",
				"-cJf",
				"{to}.tar.xz",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{to}.tar.xz"
			}
		},
		{
			"id": "compress.tar-zst",
			"label": "As a .tar.zst…",
			"submenu": "Compress",
			"when": {
				"count": "some",
				"real": true,
				"in": [
					"folder"
				],
				"programs": [
					"tar",
					"zstd"
				]
			},
			"ask": {
				"to": {
					"text": "Name of the archive",
					"start": "{stem}"
				}
			},
			"run": [
				"tar",
				"--zstd",
				"-cf",
				"{to}.tar.zst",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{to}.tar.zst"
			}
		},
		{
			"id": "compress.tar",
			"label": "As a .tar…",
			"submenu": "Compress",
			"when": {
				"count": "some",
				"real": true,
				"in": [
					"folder"
				],
				"programs": [
					"tar"
				]
			},
			"ask": {
				"to": {
					"text": "Name of the archive",
					"start": "{stem}"
				}
			},
			"run": [
				"tar",
				"-cf",
				"{to}.tar",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true,
				"choose": "{to}.tar"
			}
		},
		{
			"id": "archive.tar.extract",
			"label": "Extract to…",
			"when": {
				"in": [
					"archive.tar"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"run": [
				"tar",
				"--skip-old-files",
				"-xf",
				"{archive}",
				"-C",
				"{dest}",
				"--strip-components={depth}",
				"--",
				"{entries}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.tar.extract-beside",
			"label": "Extract beside the archive",
			"when": {
				"in": [
					"archive.tar"
				]
			},
			"like": "archive.tar.extract",
			"given": {
				"dest": "{archive.parent}"
			}
		},
		{
			"id": "archive.tar.extract-all",
			"label": "Extract all to…",
			"when": {
				"target": "folder",
				"in": [
					"archive.tar"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"run": [
				"tar",
				"--skip-old-files",
				"-xf",
				"{archive}",
				"-C",
				"{dest}"
			],
			"how": {
				"watched": true
			}
		},
		{
			"id": "archive.tar.remove",
			"label": "Remove from archive",
			"when": {
				"in": [
					"archive.tar"
				],
				"with": {
					"archive": [
						"*.tar"
					]
				}
			},
			"run": [
				"tar",
				"--delete",
				"-f",
				"{archive}",
				"--",
				"{entries}"
			],
			"how": {
				"watched": true,
				"confirm": "What is removed from the archive cannot be put back."
			},
			"then": {
				"reread": true
			},
			"key": "Delete"
		},
		{
			"id": "archive.tar.add",
			"label": "Add to archive",
			"when": {
				"in": [
					"archive.tar"
				],
				"with": {
					"archive": [
						"*.tar"
					]
				},
				"real": true
			},
			"run": [
				"tar",
				"-rf",
				"{archive}",
				"-C",
				"{folder}",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.zip.extract",
			"label": "Extract to…",
			"when": {
				"in": [
					"archive.zip"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"run": [
				"sh",
				"-c",
				"t=$1; shift; for e; do case \"$e\" in */) set -- \"$@\" \"$e\" \"$e*\";; *) set -- \"$@\" \"$e\";; esac; shift; done; unzip -n -q \"$archive\" \"$@\" -d \"$t\" || exit 1; cd \"$t/$within\" && tar -cf - . | tar --skip-old-files -xf - -C \"$dest\"",
				"sh",
				"{temp}",
				"{entries}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "archive.zip.extract-beside",
			"label": "Extract beside the archive",
			"when": {
				"in": [
					"archive.zip"
				]
			},
			"like": "archive.zip.extract",
			"given": {
				"dest": "{archive.parent}"
			}
		},
		{
			"id": "archive.zip.extract-all",
			"label": "Extract all to…",
			"when": {
				"target": "folder",
				"in": [
					"archive.zip"
				]
			},
			"ask": {
				"dest": {
					"folder": "Extract to",
					"start": "{archive.parent}"
				}
			},
			"run": [
				"unzip",
				"-n",
				"-q",
				"{archive}",
				"-d",
				"{dest}"
			],
			"how": {
				"watched": true
			}
		},
		{
			"id": "archive.zip.remove",
			"label": "Remove from archive",
			"when": {
				"in": [
					"archive.zip"
				],
				"programs": [
					"zip"
				]
			},
			"run": [
				"sh",
				"-c",
				"for e; do case \"$e\" in */) set -- \"$@\" \"$e\" \"$e*\";; *) set -- \"$@\" \"$e\";; esac; shift; done; zip -q -d \"$archive\" \"$@\"",
				"sh",
				"{entries}"
			],
			"how": {
				"watched": true,
				"confirm": "What is removed from the archive cannot be put back."
			},
			"then": {
				"reread": true
			},
			"key": "Delete"
		},
		{
			"id": "archive.zip.add",
			"label": "Add to archive",
			"when": {
				"in": [
					"archive.zip"
				],
				"programs": [
					"zip"
				],
				"real": true
			},
			"run": [
				"zip",
				"-q",
				"-r",
				"{archive}",
				"--",
				"{names}"
			],
			"how": {
				"watched": true
			},
			"then": {
				"reread": true
			}
		},
		{
			"id": "git.changes",
			"label": "Changed files (git)",
			"when": {
				"target": "folder",
				"kind": "folder",
				"inside": [
					".git"
				],
				"programs": [
					"git"
				]
			},
			"show": {
				"place": "git.changes",
				"with": {
					"repo": "{path}"
				}
			}
		}
	]
}
